        "number",
        "null"
      ]
    },
    "baseline_distribution": {
      "type": "object"
    },
    "baseline_size": {
      "type": "integer"
    },
    "candidate_distribution": {
      "type": "object"
    },
    "candidate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "coverage": {
      "type": "number"
    },
    "effect_id": {
      "type": "string"
    },
    "effect_metrics": {
      "type": "object"
    },
    "experiment_id": {
      "type": "string"
    },
    "feature_conditions": {
      "type": "array"
    },
    "fold_results": {
      "type": "array"
    },
    "instrument": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "multiplicity_family": {
      "type": "string"
    },
    "pattern_definition": {
      "type": "object"
    },
    "rank_within_experiment": {
      "type": "integer"
    },
    "raw_p": {
      "type": [
        "number",
        "null"
      ]
