        "$ref": "#/definitions/v1Side",
        "title": "Сторона сделки (long или short)"
      },
      "size": {
        "$ref": "#/definitions/typeDecimal",
        "description": "Размер в шт."
      },
      "symbol": {
        "title": "Символ инструмента",
        "type": "string"
      },
