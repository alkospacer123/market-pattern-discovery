  },
  "publisher": "FinamWeb/finam-trade-api",
  "rest_trades": {
    "http_400_description": "Неверно передан интервал",
    "method": "GET",
    "parameters": [
      {
        "description": "Идентификатор аккаунта",
        "in": "path",
        "name": "account_id",
        "required": true,
        "type": "string"
      },
      {
        "description": "Лимит количества сделок",
        "format": "int32",
        "in": "query",
        "name": "limit",
        "required": false,
        "type": "integer"
      },
      {
        "description": "Optional. Inclusive start of the interval.\n\nIf specified, a Timestamp matching this interval will have to be the same\nor after the start.",
        "format": "date-time",
        "in": "query",
        "name": "interval.start_time",
        "required": false,
        "type": "string"
      },
      {
        "description": "Exclusive end of the interval.\n\nA Timestamp matching this interval will have to be before the\nend.",
        "format": "date-time",
        "in": "query",
        "name": "interval.end_time",
        "required": false,
        "type": "string"
      }
    ],
    "path": "/v1/accounts/{account_id}/trades",
    "response": {
      "properties": {
        "trades": {
          "items": {
            "$ref": "#/definitions/v1AccountTrade",
            "type": "object"
          },
          "title": "Сделки по аккаунту",
          "type": "array"
        }
      },
      "title": "История по сделкам",
      "type": "object"
    }
  },
