  "commit": "52c95c8672542c2f89fbee2a4016774e73a0caa4",
  "interpretation": "Documentary contract only. Existing HTTP400 attribution to omitted interval is plausible, not physically confirmed. No FINAM request performed.",
  "order_state_fields": [
    "accept_at",
    "exec_id",
    "executed_quantity",
    "initial_quantity",
    "order",
    "order_id",
