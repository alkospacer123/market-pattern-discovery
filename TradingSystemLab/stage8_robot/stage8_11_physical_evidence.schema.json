{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage8_11_physical_acceptance.v1",
  "title": "Sanitized Stage 8.11 physical acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_id",
    "schema_id",
    "production_specification_id",
    "stage8_11_status",
    "accepted_code_commit",
    "sanitized_account_identity_hash",
    "instrument",
    "direction",
    "quantity",
    "preflight_gate_outcomes",
    "kill_switch_pre_state",
    "kill_switch_final_state",
    "execution_authorization_observed",
    "order_endpoint_call_count",
    "broker_order_present",
    "broker_fill_count",
    "entry_fill_proven",
    "one_contract_position_observed",
    "controlled_flatten_proven",
    "final_position_quantity",
    "final_active_order_count",
    "unresolved_intent_count",
    "reconciliation_result",
    "physical_result_classification",
    "external_raw_evidence_sha256"
  ],
  "properties": {
    "attempt_id": {
      "const": "stage8.11.attempt2"
    },
    "schema_id": {
      "const": "stage8_11_physical_acceptance.v1"
    },
    "production_specification_id": {
      "const": "PROD_STAGE7_46DB784378797C7FB04636892350AFF21006D71A31F2CED9D4B974EDA2DC36B8"
    },
    "stage8_11_status": {
      "const": "PHYSICAL_RESULT_REQUIRES_INDEPENDENT_AUDIT"
    },
    "accepted_code_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sanitized_account_identity_hash": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "instrument": {
      "enum": [
        "USDRUBF",
        "CNYRUBF",
        "GLDRUBF",
        "IMOEXF"
      ]
    },
    "direction": {
      "enum": [
        "LONG",
        "SHORT"
      ]
    },
    "quantity": {
      "const": 1
    },
    "preflight_gate_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account_binding": {
          "type": "boolean"
        },
        "credential_scope": {
          "type": "boolean"
        },
        "session_write_capable": {
          "type": "boolean"
        },
        "initial_reconciliation": {
          "type": "boolean"
        },
        "instrument_binding": {
          "type": "boolean"
        },
        "instrument_tradable": {
          "type": "boolean"
        },
        "r15_capacity": {
          "type": "boolean"
        },
        "margin_capacity": {
          "type": "boolean"
        },
        "h1_data_safety": {
          "type": "boolean"
        }
      }
    },
    "kill_switch_pre_state": {
      "const": "ARMED"
    },
    "kill_switch_final_state": {
      "const": "HALTED"
    },
    "execution_authorization_observed": {
      "type": "boolean"
    },
    "order_endpoint_call_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "broker_order_present": {
      "type": "boolean"
    },
    "broker_fill_count": {
      "type": "integer",
      "minimum": 0
    },
    "final_position_quantity": {
      "type": ["integer", "null"]
    },
    "final_active_order_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "unresolved_intent_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "reconciliation_result": {
      "enum": [
        "PASS",
        "FAIL",
        "UNRESOLVED"
      ]
    },
    "physical_result_classification": {
      "enum": [
        "PASS",
        "BLOCKED_PRE_SUBMISSION",
        "NOT_ACCEPTED_NO_EXECUTION",
        "OPERATOR_INTERVENTION_REQUIRED",
        "PENDING_PHYSICAL_ACCEPTANCE"
      ]
    },
    "external_raw_evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "entry_fill_proven": {
      "type": "boolean"
    },
    "one_contract_position_observed": {
      "type": "boolean"
    },
    "controlled_flatten_proven": {
      "type": "boolean"
    }
  }
}
