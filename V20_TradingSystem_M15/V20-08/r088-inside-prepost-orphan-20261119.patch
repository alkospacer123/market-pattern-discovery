+def _resolve_never_posted_entry(journal, snapshot, key: str, payload: dict) -> bool:
+    """Release only a PRE-POST intent proved absent from FINAM. All robots."""
+    row = journal.store.intent(key)
+    symbol = payload["finam_symbol"]
+    if (row is None or row["status"] != "INTENT_PERSISTED"
+            or row["broker_order_id"] is not None
+            or journal.store.get("live_post:" + key) is not None
+            or journal.store.get("entry_submission:" + key) is not None
+            or journal.store.get("flat_cleanup:" + key) is not None
+            or snapshot.positions.get(symbol, 0)
+            or any(o.active and o.symbol == symbol for o in snapshot.orders)):
+        return False
+    if journal.reconcile_order(key=key, snapshot=snapshot) != "PREPARED_ONLY_NO_POST":
+        return False
+    with journal.store.transaction():
+        current = journal.store.intent(key)
+        if (current is None or current["status"] != "INTENT_PERSISTED"
+                or current["broker_order_id"] is not None
+                or journal.store.get("live_post:" + key) is not None
+                or journal.store.get("entry_submission:" + key) is not None
+                or journal.store.get("flat_cleanup:" + key) is not None):
+            raise V20FinamBlocked("V20_PREPOST_RECOVERY_STATE_CHANGED")
+        journal.store.transition_intent(key, "CANCELLED")
+        journal.store.put("flat_cleanup:" + key, {
+            "status": "PREPOST_ABORT_NO_FINAM_ORDER",
+            "account_sha256": journal.account_hash,
+        })
+        _close_flat(journal, key)
+    # Session quota and NEXT_OPEN decision remain consumed: never re-enter.
+    return True
+
+
